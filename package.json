{
    "name": "lonys-bucket-list",
    "version": "1.0.0",
    "description": "Lony's Bucket List — A portable desktop bucket list app",
    "main": "src/main/main.js",
    "scripts": {
        "dev:renderer": "vite",
        "dev:electron": "electron .",
        "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
        "build:renderer": "vite build",
        "build": "npm run build:renderer && electron-builder",
        "dist": "npm run build"
    },
    "author": "Lony",
    "license": "MIT",
    "devDependencies": {
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "concurrently": "^8.2.2",
        "electron": "^28.2.0",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "vite": "^5.1.0",
        "wait-on": "^7.2.0"
    },
    "dependencies": {
        "canvas-confetti": "^1.9.2",
        "framer-motion": "^11.0.3",
        "lucide-react": "^0.316.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sharp": "^0.33.2",
        "uuid": "^9.0.0"
    },
    "build": {
        "appId": "com.lony.bucketlist",
        "productName": "Lony's Bucket List",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/main/**/*",
            "dist-renderer/**/*",
            "public/**/*"
        ],
        "extraResources": [
            {
                "from": "data",
                "to": "data",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.png"
        },
        "portable": {
            "artifactName": "LonysBucketList-${version}-portable.exe",
            "requestExecutionLevel": "user",
            "unpackDirName": "lonys-bucket-list-data"
        }
    }
}